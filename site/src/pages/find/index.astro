---
import Base from '../../layouts/Base.astro';
import clinics from '../../data/clinics.json';
const states = {};
for (const c of clinics) (states[c.stateSlug] ||= { slug: c.stateSlug, name: c.stateName, n: 0 }).n++;
const title = `WIC Office Near Me: Find Your Local Clinic (${clinics.length.toLocaleString('en-US')} Locations)`;
const desc = `Find the WIC office near you: search ${clinics.length.toLocaleString('en-US')} clinics by city or ZIP, get the direct phone number, and check the 2026-2027 income limits before you call.`;
---
<Base title={title} desc={desc}>
<main class="wrap">
  <div class="migas"><a href="/">Home</a> › Find a clinic</div>
  <span class="sello">{clinics.length.toLocaleString('en-US')} clinics tracked</span>
  <h1 style="font-size:1.65rem">WIC office near me: find your local clinic</h1>
  <p class="lede">Type your city, ZIP code or clinic name to get the direct phone number — or browse by state below. Every listing shows the address and number you need to book a certification appointment.</p>
  <input class="filtro" id="q" type="search" placeholder="Search by city, ZIP or clinic name…" autocomplete="off" />
  <div class="tarjetas" id="hits" style="display:none"></div>
  <div class="tarjetas" id="states">
    {Object.values(states).sort((a,b) => a.name.localeCompare(b.name)).map(s => <a class="tarj" href={`/${s.slug}/`}><h3>{s.name}</h3><p class="sub">{s.n} clinics</p></a>)}
  </div>
  <h2>Before you call your local WIC office</h2>
  <ul>
    <li><strong>Check that you qualify:</strong> income up to $61,050/year for a family of 4 (2026-2027), a pregnancy counts as an extra household member, and Medicaid, SNAP or TANF makes you automatically eligible. <a href="/wic-income-guidelines/">Full table</a>.</li>
    <li><strong>Know what to bring:</strong> photo ID, proof of address, proof of income (or your Medicaid/SNAP card) and the children applying. <a href="/how-to-apply-for-wic/">Step by step</a>.</li>
    <li><strong>Ask about online options:</strong> 26 states let you start the application online before your visit — your state page says which.</li>
    <li><strong>Pregnant or with an infant?</strong> Say so when you call: federal rules give those categories priority scheduling within 10 days.</li>
  </ul>
  <h2>What if there's no clinic listed in my town?</h2>
  <p>WIC clinics serve entire counties, so the nearest one may be in a neighboring town — check your state page for the full list, or call your <a href="/wic-appointment/">state hotline</a> (shown on each state page) for a referral. Many rural areas also run scheduled satellite clinics that don't appear in locators.</p>
  <div class="fuente">Details from public sources — confirm with the clinic by phone.</div>
</main>
<script define:vars={{ mini: clinics.map(c => ({ s: c.slug, n: c.name.slice(0, 46), c: c.city, st: c.state, z: c.zip })) }}>
const q = document.getElementById('q'), hits = document.getElementById('hits'), st = document.getElementById('states');
q.addEventListener('input', () => {
  const v = q.value.trim().toLowerCase();
  if (v.length < 2) { st.style.display = ''; hits.style.display = 'none'; return; }
  const r = mini.filter(c => c.n.toLowerCase().includes(v) || c.c.toLowerCase().includes(v) || c.z.startsWith(v)).slice(0, 24);
  st.style.display = 'none'; hits.style.display = '';
  hits.innerHTML = r.length ? r.map(c => `<a class="tarj" href="/clinic/${c.s}/"><h3>${c.n}</h3><p class="sub">${c.c}, ${c.st} ${c.z}</p></a>`).join('') : '<p style="padding:14px">No matches — try the state pages below.</p>';
  if (!r.length) st.style.display = '';
});
</script>
</Base>
