---
import Base from '../../layouts/Base.astro';
import clinics from '../../data/clinics.json';
import agencies from '../../data/state-agencies.json';
export function getStaticPaths() {
  const m = {};
  for (const c of clinics) {
    const k = c.stateSlug + '/' + c.citySlug;
    (m[k] ||= { stateSlug: c.stateSlug, citySlug: c.citySlug, city: c.city, stateName: c.stateName, st: c.state, list: [] }).list.push(c);
  }
  return Object.values(m).map(ci => ({ params: { state: ci.stateSlug, city: ci.citySlug }, props: { ci } }));
}
const { ci } = Astro.props;
const n = ci.list.length;
const ALIAS = { 'u-s-virgin-islands': 'virgin-islands' };
const ag = agencies[ALIAS[ci.stateSlug] || ci.stateSlug] || {};
const title = `WIC Office${n === 1 ? '' : 's'} in ${ci.city}, ${ci.st}: ${n === 1 ? 'Address & Phone' : `${n} Clinics + Phones`}`;
const desc = `Where to apply for WIC in ${ci.city}, ${ci.stateName}: ${n} ${n === 1 ? 'clinic' : 'clinics'} with phone and address, current income limits and the documents to bring.`;
const schemaCol = { "@context":"https://schema.org","@type":"CollectionPage","name":title,
  "mainEntity":{"@type":"ItemList","numberOfItems":n,"itemListElement":ci.list.map((c,i)=>({"@type":"ListItem","position":i+1,"name":c.name,"url":`https://wicclinics.com/clinic/${c.slug}/`}))}};
const faq = [
  { q: `What documents are required to complete a WIC application in ${ci.stateName}?`, a: `Four things: photo ID for the adult; a birth certificate, crib card or medical record for each child applying; proof of your ${ci.city} address (lease, utility bill or official mail); and proof of income — recent pay stubs, OR simply your Medicaid, SNAP or TANF card, which proves income eligibility by itself. Don't have everything? Go anyway: a sworn statement is generally accepted as a last resort and you typically get 30 days to complete proof.` },
  { q: `What's the maximum income to qualify for WIC in ${ci.stateName}?`, a: `${ci.stateName} uses the federal maximum of 185% of poverty. For July 2026 through June 2027: $29,526/year for a household of 1, $40,034 for 2, $50,542 for 3, $61,050 for 4, plus $10,508 for each additional member — gross income, before taxes. A pregnancy counts as at least one extra household member, and anyone with Medicaid, SNAP or TANF is automatically income-eligible regardless of these numbers.` },
  { q: `Can I apply for ${ci.stateName} WIC online?`, a: ag.online ? `Yes — ${ci.stateName} accepts online applications${ag.apply ? ` (${ag.apply.replace(/\.$/, '')})` : ''}. You start online and finish certification at a clinic, where the health check happens and your eWIC card is issued. Starting online usually means a shorter visit.` : `${ci.stateName} does not offer a full online application — enrollment runs through your local clinic${ag.apply ? `: ${ag.apply.toLowerCase().replace(/\.$/, '')}` : ''}. Call one of the ${ci.city} clinics above to book; certification is usually completed in a single visit.` },
  { q: `Is there a number to call to check WIC benefits in ${ci.stateName}?`, a: ag.tollFree ? `Yes — the ${ci.stateName} WIC state hotline is ${ag.tollFree} (toll-free)${ag.dept ? `, run by the ${ag.dept}` : ''}. Use it for benefit questions, clinic referrals and appointment help. For your eWIC balance, the state WIC app and your last receipt show it instantly, and the clinics listed above answer local questions directly.` : `Your local clinic is the fastest route — each listing above has its direct number. Your eWIC balance also shows in the state WIC app and on your last store receipt.` }
];
const schemaFaq = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faq.map(x=>({"@type":"Question","name":x.q,"acceptedAnswer":{"@type":"Answer","text":x.a}}))};
const crumbs = {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Home","item":"https://wicclinics.com/"},
  {"@type":"ListItem","position":2,"name":ci.stateName,"item":`https://wicclinics.com/${ci.stateSlug}/`},
  {"@type":"ListItem","position":3,"name":`WIC in ${ci.city}`}]};
---
<Base title={title} desc={desc} schema={schemaCol}>
<main class="wrap">
  <div class="migas"><a href="/">Home</a> › <a href={`/${ci.stateSlug}/`}>{ci.stateName}</a> › {ci.city}</div>
  <span class="sello">{n} {n === 1 ? 'clinic' : 'clinics'} · {ci.city}, {ci.st}</span>
  <h1 style="font-size:1.65rem">WIC offices in {ci.city}, {ci.stateName}</h1>
  <p class="lede">{n === 1 ? 'The WIC clinic serving' : `The ${n} WIC clinics serving`} {ci.city} — call to book your certification appointment. Pregnant women and infants get priority (10-day maximum wait by federal rule).</p>
  <div class="tarjetas">
    {ci.list.map(c => <a class="tarj" href={`/clinic/${c.slug}/`}><h3>{c.name.slice(0, 44)}</h3><p class="sub">{c.street.slice(0, 46)}</p>{c.phone && <p class="sub" style="color:var(--teal);font-weight:700">{c.phone}</p>}</a>)}
  </div>
  {(ag.tollFree || ag.online) && <div class="nota">
    {ag.tollFree && <span><strong>{ci.stateName} WIC hotline:</strong> <a href={`tel:${ag.tollFree.replace(/\D/g,'')}`}>{ag.tollFree}</a> (toll-free) for clinic referrals and benefit questions. </span>}
    {ag.online && <span><strong>Good news:</strong> {ci.stateName} accepts <a href={`/${ci.stateSlug}/`}>online applications</a> — start at home, finish at the clinic.</span>}
  </div>}

  <h2>Applying in {ci.city}: the short version</h2>
  <ul>
    <li><strong>Who qualifies:</strong> pregnant and postpartum women, infants, and children under 5 — applied for by any caregiver, including dads and grandparents. <a href="/wic-eligibility/">Full rules</a>.</li>
    <li><strong>Income:</strong> up to $61,050/year for a family of 4 (2026-2027 table), or automatic with Medicaid/SNAP/TANF. <a href="/wic-income-guidelines/">Full table</a>.</li>
    <li><strong>What you get:</strong> monthly foods on an eWIC card, infant formula covered in full, produce dollars, and breastfeeding support. <a href="/what-does-wic-cover/">Details</a>.</li>
  </ul>
  <h2>Frequently asked questions</h2>
  {faq.map(x => <details class="faq"><summary>{x.q}</summary><div><p>{x.a}</p></div></details>)}
  <div class="fuente">Independent directory. Clinic details from public sources — confirm by phone before visiting.</div>
</main>
<script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />
<script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
</Base>
