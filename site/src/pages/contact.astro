import Base from '../layouts/Base.astro';
---
<Base title="Contact | WIC Clinics" desc="Report an outdated WIC clinic phone number, address or closure so we can verify and correct it against official sources.">
<main class="wrap">
  <h1 style="font-size:1.65rem">Contact</h1>
  <p class="lede">Clinic moved? Phone changed?</p>
  <p>Email <strong>info@wicclinics.com</strong> with the clinic name and correction. We verify against public sources before updating.</p>
  <div class="nota"><strong>Please note:</strong> we are not a WIC agency. We cannot book appointments, check application status, or access any records. For those, call your clinic directly — every listing here has its number.</div>
</main>
</Base>
